# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info

# ── Database (MUST be a replica set — transactions are required) ──
# `npm run db` (local replica set) and `docker compose up -d` both listen on 27018.
MONGO_URI=mongodb://127.0.0.1:27018/stocksense?directConnection=true

# ── Auth ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# true in production (HTTPS). false for local http dev.
COOKIE_SECURE=false

# ── Mail (OTP). Leave SMTP_HOST empty in dev to log OTPs to the console. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="StockSense <no-reply@stocksense.io>"
